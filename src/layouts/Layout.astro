---
import "../styles/global.css";
import { DEFAULT_SITE_URL, SEO_KEYWORDS } from "../components/seo";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "profile" | "article";
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "Личный сайт-навигатор Свами Благомира Шиванатха Тапасви, Хранителя Шива Дева-Парампары. Духовное знание, осознанная практика и система «Путь Дхармы».",
  canonicalPath = Astro.url.pathname,
  ogType = "website",
  ogImage = "/images/og.jpg",
  noindex = false,
  jsonLd,
} = Astro.props;

const siteOrigin = (Astro.site?.origin ?? DEFAULT_SITE_URL).replace(/\/$/, "");
const normalizedPath = canonicalPath.startsWith("/") ? canonicalPath : `/${canonicalPath}`;
const canonicalUrl = `${siteOrigin}${normalizedPath}`;
const ogImageUrl = ogImage.startsWith("http") ? ogImage : `${siteOrigin}${ogImage}`;
const robotsContent = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang="ru" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SEO_KEYWORDS.join(", ")} />
    <meta name="author" content="Свами Благомир Шиванатха Тапасви" />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="yandex" content="index, follow" />
    <meta name="theme-color" content="#0F172A" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ru" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="LLMs summary" href="/llms.txt" />
    <link rel="alternate" type="text/plain" title="LLMs full context" href="/llms-full.txt" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/images/dharma-wheel.svg" as="image" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500;1,600&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="ДХАРМА108" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="629" />
    <meta
      property="og:image:alt"
      content="Свами Благомир Шиванатха Тапасви — Хранитель Шива Дева-Парампары, ДХАРМА108"
    />

    <!-- Twitter / Telegram preview -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

    <style is:inline>
      #dharma-preloader {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-color: #0f172a;
        background-image:
          radial-gradient(90% 55% at 78% 12%, rgba(212, 175, 55, 0.13) 0%, rgba(15, 23, 42, 0) 60%),
          radial-gradient(70% 50% at 8% 88%, rgba(17, 75, 78, 0.35) 0%, rgba(15, 23, 42, 0) 65%);
        transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.55s;
      }
      html:has(#dharma-preloader:not(.is-hidden)) body {
        background-color: #0f172a;
      }
      #dharma-preloader.is-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      .dharma-wheel-svg {
        display: block;
        width: 112px;
        height: 112px;
        object-fit: contain;
        animation: dharma-wheel-spin 9s linear infinite;
      }
      @keyframes dharma-wheel-spin {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .dharma-wheel-svg {
          animation-duration: 24s;
        }
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col">
    <div id="dharma-preloader" aria-hidden="true">
      <img
        class="dharma-wheel-svg"
        src="/images/dharma-wheel.svg"
        width="112"
        height="112"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <script is:inline>
      (function () {
        var el = document.getElementById("dharma-preloader");
        if (!el) return;
        var done = false;
        function hide() {
          if (done) return;
          done = true;
          el.classList.add("is-hidden");
          setTimeout(function () {
            if (el && el.parentNode) el.parentNode.removeChild(el);
          }, 600);
        }
        window.addEventListener("dharma:ready", hide, { once: true });
        setTimeout(hide, 4000);
      })();
    </script>

    <slot />
  </body>
</html>
